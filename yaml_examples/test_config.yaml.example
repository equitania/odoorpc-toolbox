# Odoo test instance configuration
# Copy this file to test_config.yaml and adjust values:
#   cp yaml_examples/test_config.yaml.example yaml_examples/test_config.yaml
#
# Required: Odoo 18 Community with demo data enabled.
# Required modules: base, product, sale, contacts
# Optional modules: stock (orderpoint tests), l10n_de (German state tests)
#
# Start Odoo:
#   cd v18/v18-dev/dev18_native && ./start-native.sh -d odoorpc_test
Server:
  url: http://localhost
  port: 8069
  user: admin
  password: admin
  database: odoorpc_test
  protocol: jsonrpc

# Transport backend (optional - uncomment to customize)
# transport:
#   backend: auto              # "auto", "urllib", or "httpx"
#   http2: true                # Enable HTTP/2 (httpx only)
#   pool_connections: 10       # Max pooled connections (httpx only)

# Retry configuration (optional - uncomment to customize)
# retry:
#   max_attempts: 3
#   backoff_factor: 0.5
#   retry_on: [502, 503, 504]

# Timeout configuration (optional - uncomment to customize)
# timeout:
#   connect: 30
#   read: 120

# Cache configuration (optional - uncomment to customize)
# cache:
#   maxsize: 256
#   ttl: 3600
